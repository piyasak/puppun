# ClipFlow server configuration example. Copy to .env for local development.
# Never commit real values. Defaults are safe: development, dry-run posting, sandbox billing.

APP_ENV=development            # development | staging | production (production only with release approval)
DATABASE_URL=                  # e.g. postgresql+psycopg://clipflow:clipflow@localhost:5432/clipflow
REDIS_URL=                     # e.g. redis://localhost:6379/0
OBJECT_STORAGE_ENDPOINT=       # local MinIO in development, e.g. http://localhost:9000
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
WEB_ORIGIN=http://localhost:5173
AI_PROVIDER=                   # empty = disabled; provider chosen after P1 cost measurement (Q-02)
AI_API_KEY=
BILLING_PROVIDER=sandbox       # only the internal sandbox adapter exists until D06 is decided
BILLING_API_KEY=
BILLING_WEBHOOK_SECRET=
POSTING_MODE=dry_run           # dry_run only; live posting requires explicit authorization, not this file

# The Windows Agent has its own config (SERVER_URL, AGENT_USERNAME); its token lives in
# Windows Credential Manager. Never copy server DB/storage/billing secrets to the Agent.
